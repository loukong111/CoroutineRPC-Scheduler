# Copy to /etc/corpcron/corpcron.env and chmod 600.
# Do not commit real production secrets.

CORPCRON_RPC_AUTH_TOKEN=change_me_to_a_long_random_token
CORPCRON_MYSQL_HOST=127.0.0.1
CORPCRON_MYSQL_PORT=3306
CORPCRON_MYSQL_USER=corpcron
CORPCRON_MYSQL_PASSWORD=change_me
CORPCRON_MYSQL_DATABASE=corpcron
CORPCRON_MYSQL_POOL_SIZE=8
CORPCRON_REDIS_HOST=127.0.0.1
CORPCRON_REDIS_PORT=6379
CORPCRON_REDIS_POOL_SIZE=8
CORPCRON_REDIS_CONNECT_TIMEOUT_MS=1000
CORPCRON_REDIS_COMMAND_TIMEOUT_MS=1000
CORPCRON_MYSQL_CONNECT_TIMEOUT_SEC=3
CORPCRON_MYSQL_READ_TIMEOUT_SEC=5
CORPCRON_MYSQL_WRITE_TIMEOUT_SEC=5
CORPCRON_MYSQL_RECONNECT=1
CORPCRON_SERVER_ADVERTISE_HOST=127.0.0.1
CORPCRON_SERVER_LISTEN_PORT=8081
CORPCRON_METRICS_HOST=127.0.0.1
CORPCRON_METRICS_PORT=9091
