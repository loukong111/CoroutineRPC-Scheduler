# Copy to /etc/corpcron/worker.env and chmod 600.
# Use the same RPC token as the control plane.

CORPCRON_RPC_AUTH_TOKEN=change_me_to_a_long_random_token
CORPCRON_REDIS_HOST=127.0.0.1
CORPCRON_REDIS_PORT=6379
CORPCRON_REDIS_POOL_SIZE=8
CORPCRON_REDIS_CONNECT_TIMEOUT_MS=1000
CORPCRON_REDIS_COMMAND_TIMEOUT_MS=1000
CORPCRON_WORKER_ADVERTISE_HOST=127.0.0.1
CORPCRON_WORKER_LISTEN_PORT=8181
CORPCRON_WORKER_MIN_THREADS=4
CORPCRON_WORKER_MAX_THREADS=16
CORPCRON_WORKER_MAX_PENDING_REQUESTS=1024
CORPCRON_METRICS_HOST=127.0.0.1
CORPCRON_METRICS_PORT=9191
